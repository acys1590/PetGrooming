@model PetGrooming.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">
                        <i class="fas fa-calendar-plus"></i> Book Your Pet's Appointment
                    </h2>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">Please fill out the form below to schedule your pet's grooming appointment.</p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OwnerName" class="form-label"></label>
                                <input asp-for="OwnerName" class="form-control" placeholder="Enter your full name" />
                                <span asp-validation-for="OwnerName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PetName" class="form-label"></label>
                                <input asp-for="PetName" class="form-control" placeholder="Enter your pet's name" />
                                <span asp-validation-for="PetName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- New Pet Info Section -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Breed" class="form-label"></label>
                                <input asp-for="Breed" class="form-control" placeholder="Enter your pet's breed" />
                                <span asp-validation-for="Breed" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Age" class="form-label"></label>
                                <input asp-for="Age" class="form-control" type="number" min="0" placeholder="Age in years" />
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PetType" class="form-label"></label>
                                <select asp-for="PetType" class="form-select" asp-items="ViewBag.PetTypes">
                                    <option value="">-- Select Pet Type --</option>
                                </select>
                                <span asp-validation-for="PetType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceType" class="form-label"></label>
                                <select asp-for="ServiceType" class="form-select" asp-items="ViewBag.ServiceTypes">
                                    <option value="">-- Select Service --</option>
                                </select>
                                <span asp-validation-for="ServiceType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="your.email@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="(555) 123-4567" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AppointmentDate" class="form-label"></label>
                            <input asp-for="AppointmentDate" class="form-control" type="datetime-local" step="900" />
                            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                            <div class="form-text text-warning">
                                Appointments are only available in 15-minute slots (:00, :15, :30, :45).
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions or notes about your pet (allergies, behavioral notes, etc.)"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Main" asp-action="Index" class="btn btn-secondary me-md-2">
                                <i class="fas fa-arrow-left"></i> Back to Home
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check"></i> Book Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Service Information -->
            <div class="card mt-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Service Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Business Hours:</h6>
                            <ul class="list-unstyled">
                                <li>Monday - Friday: 8:00 AM - 6:00 PM</li>
                                <li>Saturday: 9:00 AM - 4:00 PM</li>
                                <li>Sunday: Closed</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Preparation Tips:</h6>
                            <ul class="list-unstyled">
                                <li>• Please arrive 10 minutes early</li>
                                <li>• Bring vaccination records</li>
                                <li>• Inform us of any health issues</li>
                                <li>• We'll call if we need to reschedule</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Round a Date to the next 15-minute mark
        function roundToNextQuarter(d) {
            const ms = 1000 * 60 * 15;
            return new Date(Math.ceil(d.getTime() / ms) * ms);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.querySelector('input[type="datetime-local"]');
            if (!dateInput) return;

            // Set min = now
            const now = new Date();
            const minLocal = new Date(now.getTime() - (now.getTimezoneOffset() * 60000));
            dateInput.min = minLocal.toISOString().slice(0, 16);

            // If empty, set to next quarter hour
            if (!dateInput.value) {
                const nextQ = roundToNextQuarter(new Date());
                const nextQLocal = new Date(nextQ.getTime() - (nextQ.getTimezoneOffset() * 60000));
                dateInput.value = nextQLocal.toISOString().slice(0, 16);
            }

            // Validate user input
            dateInput.addEventListener('change', function () {
                if (!dateInput.value) return;
                const picked = new Date(dateInput.value);
                const minutes = picked.getMinutes();

                if (minutes % 15 !== 0) {
                    alert("Appointments are only available in 15-minute slots (:00, :15, :30, :45). " +
                          "We have adjusted your time to the nearest slot.");

                    const aligned = roundToNextQuarter(picked);
                    const alignedLocal = new Date(aligned.getTime() - (aligned.getTimezoneOffset() * 60000));
                    dateInput.value = alignedLocal.toISOString().slice(0, 16);
                }
            });
        });
    </script>
}
