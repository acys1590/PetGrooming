@{
    Layout = "Main_Layout";
}

@using PetGrooming.Models
@model Appointment

@{
    ViewData["Title"] = "Appointment Confirmation";
}

<div class="container mt-5 mb-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <!-- Neutral header (no success unless TempData is set by payment) -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-calendar-check"></i> Appointment Created
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Your appointment has been created. Please proceed to payment to confirm your booking.
                    </p>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary">Pet Owner Information</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Name:</strong></td>
                                    <td>@Model.OwnerName</td>
                                </tr>
                                <tr>
                                    <td><strong>Email:</strong></td>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <td><strong>Phone:</strong></td>
                                    <td>@Model.PhoneNumber</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary">Pet & Service</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Pet Name:</strong></td>
                                    <td>@Model.PetName</td>
                                </tr>
                                <tr>
                                    <td><strong>Pet Type:</strong></td>
                                    <td>@Model.PetType</td>
                                </tr>
                                <tr>
                                    <td><strong>Service:</strong></td>
                                    <td>@Model.Service?.Name</td>
                                </tr>
                                <tr>
                                    <td><strong>Price:</strong></td>
                                    <td>RM @Model.Service?.Price.ToString("0.00")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-12">
                            <h5 class="text-primary">Appointment Schedule</h5>
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-calendar-alt text-primary me-2" style="font-size: 1.5rem;"></i>
                                <div>
                                    <strong>Date & Time:</strong><br />
                                    <span class="fs-5">@Model.AppointmentDate.ToString("dddd, MMMM dd, yyyy")</span><br />
                                    <span class="fs-5">@Model.AppointmentDate.ToString("h:mm tt")</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <h5 class="text-primary">Special Notes</h5>
                                <div class="alert alert-light">
                                    @Model.Notes
                                </div>
                            }
                        </div>
                    </div>

                    <div class="text-center mt-4 mb-3">
                        <a asp-controller="Appointment" asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-success">
                            <i class="fas fa-credit-card"></i> Proceed to Payment
                        </a>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i> You will see a success message here only after payment is completed.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
