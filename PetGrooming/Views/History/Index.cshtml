@model PetGroomingSystem.Models.ViewModels.HistoryListVM
@{
    ViewData["Title"] = "Appointment History";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Appointment History</h4>

            <!-- Search -->
            <form method="get" asp-action="Index" class="d-flex">
                <input type="text" name="search" value="@Model.Search"
                       class="form-control me-2"
                       placeholder="🔍 Search by name or service" />
                <button type="submit" class="btn btn-light">Search</button>
            </form>
        </div>

        <div class="card-body">
            <!-- History Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>Member Name</th>
                            <th>Email</th>
                            <th>Service</th>
                            <th class="text-end">Price</th>
                            <th>Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Appointments.Any())
                        {
                            foreach (var item in Model.Appointments)
                            {
                                <tr>
                                    <td>@item.MemberName</td>
                                    <td>@item.MemberEmail</td>
                                    <td>@item.ServiceName</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td>@item.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td>@item.Notes</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No history found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search">Previous</a>
                    </li>

                    @for (int i = 1; i <= Math.Ceiling((double)Model.TotalItems / Model.PageSize); i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@Model.Search">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page* Model.PageSize >= Model.TotalItems ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>
