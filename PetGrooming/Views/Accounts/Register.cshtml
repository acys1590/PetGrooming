@using PetGroomingSystem.Models.ViewModels
@model RegisterVM

@{
    ViewBag.Title = "Account | Register";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 fw-bold">Create Account</h3>

                    <form class="needs-validation" method="post" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Your full name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3">
                            <label asp-for="Confirm" class="form-label"></label>
                            <input asp-for="Confirm" class="form-control" type="password" placeholder="Confirm password" />
                            <span asp-validation-for="Confirm" class="text-danger small"></span>
                        </div>

                        <!-- Photo Upload -->
                        <div class="mb-3">
                            <label asp-for="Photo" class="form-label"></label>
                            <div class="d-flex align-items-center">
                                <label class="upload-btn me-3">
                                    <input asp-for="Photo" type="file" accept="image/jpeg,image/png" hidden id="photoInput" />
                                    <span class="btn btn-outline-primary btn-sm">Choose Photo</span>
                                </label>
                                <img id="preview" src="/images/photo.jpg" class="rounded-circle border" width="70" height="70" style="object-fit:cover;" />
                            </div>
                            <span asp-validation-for="Photo" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary rounded-pill">Register</button>
                            <button type="reset" class="btn btn-outline-secondary rounded-pill">Reset</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section foot {
    <script>
        $.validator.setDefaults({ ignore: '' });

        // 预览上传的照片
        document.getElementById("photoInput").addEventListener("change", function (e) {
            const [file] = this.files;
            if (file) {
                document.getElementById("preview").src = URL.createObjectURL(file);
            }
        });
    </script>

    <style>
        .card {
            border-radius: 1rem;
        }
        .upload-btn input {
            display: none;
        }
    </style>
}
