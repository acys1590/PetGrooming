@model UpdatePasswordVM
@{
    ViewBag.Title = "Update Password and Reset Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-key"></i> Update Password</h3>
                </div>
                <div class="card-body">
                    <form asp-action="UpdatePassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Current" class="form-label"></label>
                            <input asp-for="Current" type="password" class="form-control" placeholder="Enter current password" />
                            <span asp-validation-for="Current" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="New" class="form-label"></label>
                            <input asp-for="New" type="password" class="form-control" placeholder="Enter new password" />
                            <span asp-validation-for="New" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Confirm" class="form-label"></label>
                            <input asp-for="Confirm" type="password" class="form-control" placeholder="Confirm new password" />
                            <span asp-validation-for="Confirm" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-save"></i> Update Password
                        </button>
                    </form>
                </div>
                <div class="card-footer text-muted text-center">
                    Make sure your new password is at least 5 characters long.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
