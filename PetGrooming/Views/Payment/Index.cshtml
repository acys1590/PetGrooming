@{
    Layout = "Main_Layout";
    var serviceId = ViewBag.ServiceId ?? 0;
    var appointmentId = ViewBag.AppointmentId ?? 0;
    var serviceName = ViewBag.ServiceName as string ?? "Service";
    var price = ViewBag.Price != null ? Convert.ToDecimal(ViewBag.Price) : 0m;
}

<div class="container mt-5">
    <h2 class="text-center mb-4">💳 Choose Payment Method</h2>

    <div class="row justify-content-center">
        <!-- Card Payment -->
        <div class="col-md-4">
            <div class="card p-3 shadow-lg text-center payment-option" data-method="card">
                <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/Visa.svg"
                     alt="Card Payment" class="img-fluid mb-2" style="height:80px;" />
                <h5 class="fw-bold">Card Payment</h5>
            </div>
        </div>

        <!-- TNG eWallet -->
        <div class="col-md-4">
            <div class="card p-3 shadow-lg text-center payment-option" data-method="tng">
                <img src="https://berita-tular.com/wp-content/uploads/2020/04/tng-2048x765.png"
                     alt="TNG eWallet" class="img-fluid mb-2" style="height:80px;" />
                <h5 class="fw-bold">TNG eWallet</h5>
            </div>
        </div>
    </div>
</div>

<script>
    const serviceId = '@serviceId';
    const appointmentId = '@appointmentId';

    document.querySelectorAll('.payment-option').forEach(option => {
        option.addEventListener('click', () => {
            const method = option.getAttribute('data-method');

            if (method === 'card') {
                // Navigate to CardPayment page with query string
                window.location.href = `/Payment/CardPayment?serviceId=${serviceId}&appointmentId=${appointmentId}`;
            }

            if (method === 'tng') {
                // Create a temporary form to POST TNG payment
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '/Payment/Index';

                form.innerHTML = `
                    <input type="hidden" name="paymentMethod" value="TNG" />
                    <input type="hidden" name="serviceId" value="${serviceId}" />
                    <input type="hidden" name="appointmentId" value="${appointmentId}" />
                `;

                document.body.appendChild(form);
                form.submit();
            }
        });
    });
</script>

<style>
    .payment-option {
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.3s ease-in-out;
        border-radius: 15px;
    }

        .payment-option:hover {
            border: 2px solid #007bff;
            transform: translateY(-3px);
        }
</style>
