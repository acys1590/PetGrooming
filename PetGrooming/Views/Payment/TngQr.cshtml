@{
    ViewData["Title"] = "TNG Payment";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg p-5" style="max-width:480px; margin:auto; border-top:5px solid #007bff;">
        <h2 class="mb-3 text-primary">📱 Touch 'n Go eWallet</h2>
        <p class="text-muted">Scan the QR code below to complete your payment</p>

        <h4 class="mt-3">@ViewBag.ServiceName</h4>
        <h5 class="text-dark mb-4">
            Total: <b>RM @((decimal)ViewBag.Price)</b>
        </h5>


        <img src="@ViewBag.QrCode" alt="TNG QR Code"
             class="img-fluid mb-4 border rounded p-3 bg-white"
             style="max-width:250px;" />

        <p class="text-muted">After scanning, you will be redirected automatically.</p>

        <hr />

        <div class="d-flex justify-content-around mt-3">
            <a href="@Url.Action("Success", "Payment", new { serviceId = ViewBag.ServiceId, appointmentId = ViewBag.AppointmentId })"
               class="btn btn-success px-4">
               I Have Paid
            </a>
        </div>
    </div>
</div>
