@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h3 class="text-center">🔐 Enter OTP</h3>
        <p class="text-danger text-center">@ViewBag.Error</p>
        <p class="text-success text-center">@ViewBag.Message</p>

        <form asp-action="VerifyOtp" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">OTP Code</label>
                <input type="text" class="form-control text-center" name="otpInput" maxlength="6" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Verify Payment</button>
        </form>

        <form asp-action="ResendOtp" method="post" class="mt-3">
            <button type="submit" class="btn btn-link w-100">Resend OTP 🔄</button>
        </form>
    </div>
</div>
