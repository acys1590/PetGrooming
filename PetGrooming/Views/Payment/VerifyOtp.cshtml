@{
    Layout = "Main_Layout";
    ViewData["Title"] = "Verify OTP";
}



<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 500px; margin:auto;">
        <h2 class="text-center text-primary mb-3">🔐 Verify OTP</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">@ViewBag.Message</div>
        }

        <form asp-action="VerifyOtp" method="post">
            <div class="mb-3">
                <label class="form-label">Enter OTP Code</label>
                <input type="text" name="otpInput" class="form-control" maxlength="6" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Verify</button>
        </form>

        <form asp-action="ResendOtp" method="get" class="mt-3">
            <button type="submit" class="btn btn-link">Resend OTP</button>
        </form>
    </div>
</div>
