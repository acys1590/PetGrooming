@using Microsoft.AspNetCore.Mvc.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pawsome Pet Grooming</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetGroomingSystem.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
</head>
<body class="bg-body text-body">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Main" asp-action="Index">
                    <span style="font-size: 1.5rem; margin-right: 8px;">🐾</span>
                    <strong>@Localizer["Pawsome Pet Grooming"]</strong>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Main" asp-action="Index">
                                <i class="fas fa-home"></i> @Localizer["Home"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Appointment" asp-action="Create">
                                <i class="fas fa-calendar-plus"></i> @Localizer["Book Appointment"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Appointment" asp-action="My">@Localizer["My Appointments"]</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Accounts" asp-action="UpdateProfile">
                                    <i class="fas fa-user"></i> @Localizer["Profile"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Accounts" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-decoration-none">
                                        <i class="fas fa-sign-out-alt"></i> @Localizer["Logout"]
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Accounts" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> @Localizer["Register"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Accounts" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> @Localizer["Login"]
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <!-- Theme toggle -->
                        <li class="nav-item me-2">
                            <button type="button" id="themeToggle" class="btn btn-outline-light btn-sm" title="@Localizer["Toggle theme"]">
                                <i class="fas fa-moon"></i> <span class="ms-1 d-none d-md-inline">@Localizer["Theme"]</span>
                            </button>
                        </li>

                        <!-- Language switch (JS sets selected to avoid RZ1031) -->
                        <li class="nav-item">
                            <form asp-controller="Localization" asp-action="SetLanguage" method="post" class="d-flex align-items-center">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <select name="culture" class="form-select form-select-sm bg-primary text-white border-0"
                                        style="width:auto" onchange="this.form.submit()" id="cultureSelect">
                                    <option value="en-US">EN</option>
                                    <option value="ms-MY">BM</option>
                                </select>
                            </form>
                        </li>
                  
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert" id="flashSuccess">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert" id="flashError">
                    <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-4">
                    <h5><span style="font-size: 1.2rem;">🐾</span> @Localizer["Pawsome Pet Grooming"]</h5>
                    <p>@Localizer["Professional pet grooming services with love and care for your furry friends."]</p>
                </div>

                <!-- Map + directions -->
                <div class="col-md-4">
                    <h5>@Localizer["Find Us"]</h5>
                    <div class="ratio ratio-4x3 rounded overflow-hidden mb-2">
                        <iframe src="https://www.google.com/maps?q=9094%20Jalan%20Genting%20Kelang%2051000%20Kuala%20Lumpur%20Federal%20Territory%20of%20Kuala%20Lumpur&output=embed"
                                style="border:0;" allowfullscreen="" loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                    <a class="btn btn-outline-light btn-sm"
                       target="_blank"
                       rel="noopener"
                       href="https://www.google.com/maps/dir/?api=1&destination=9094%20Jalan%20Genting%20Kelang%2051000%20Kuala%20Lumpur%20Federal%20Territory%20of%20Kuala%20Lumpur">
                        <i class="fas fa-location-arrow"></i> @Localizer["Get Directions"]
                    </a>
                </div>

                <div class="col-md-4">
                    <h5>@Localizer["Contact Info"]</h5>
                    <p class="mb-1"><i class="fas fa-map-marker-alt"></i> 9094 Jalan Genting Kelang, 51000 Kuala Lumpur</p>
                    <p class="mb-1"><i class="fas fa-phone"></i> 011 777 8888</p>
                    <p class="mb-1"><i class="fas fa-envelope"></i> info@pawsomegrooming.com</p>

                    <h6 class="mt-3">@Localizer["Business Hours"]</h6>
                    <p class="mb-1">@Localizer["Mon-Fri: 8:00 AM - 6:00 PM"]</p>
                    <p class="mb-1">@Localizer["Saturday: 9:00 AM - 4:00 PM"]</p>
                    <p class="mb-1">@Localizer["Sunday: Closed"]</p>
                </div>
            </div>

            <hr class="my-3">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">&copy; @DateTime.Now.Year - @Localizer["Pawsome Pet Grooming"]. @Localizer["All rights reserved."]</p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="mb-0">@Localizer["Made with"] <i class="fas fa-heart text-danger"></i> @Localizer["for pets and their owners"]</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ===== THEME TOGGLE (persist in localStorage) =====
        (function () {
            const root = document.documentElement; // <html>
            const btn = document.getElementById('themeToggle');
            const saved = localStorage.getItem('theme') || 'light';
            root.setAttribute('data-bs-theme', saved);

            if (btn) {
                const setIcon = () => {
                    const mode = root.getAttribute('data-bs-theme');
                    btn.innerHTML = (mode === 'dark')
                        ? '<i class="fas fa-sun"></i> <span class="ms-1 d-none d-md-inline">Theme</span>'
                        : '<i class="fas fa-moon"></i> <span class="ms-1 d-none d-md-inline">Theme</span>';
                };
                setIcon();

                btn.addEventListener('click', () => {
                    const current = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                    root.setAttribute('data-bs-theme', current);
                    localStorage.setItem('theme', current);
                    setIcon();
                });
            }

            // Auto-dismiss flash alerts after 3.5s
            setTimeout(() => {
                const el1 = document.getElementById('flashSuccess');
                const el2 = document.getElementById('flashError');
                if (el1) bootstrap.Alert.getOrCreateInstance(el1).close();
                if (el2) bootstrap.Alert.getOrCreateInstance(el2).close();
            }, 3500);

            // Set selected language (avoids Razor conditionals inside attributes)
            const ddl = document.getElementById('cultureSelect');
            if (ddl) {
                ddl.value = "@System.Threading.Thread.CurrentThread.CurrentUICulture.Name";
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
