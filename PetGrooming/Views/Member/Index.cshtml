@model List<PetGroomingSystem.Models.ViewModels.MemberDetailVM>

@{
    ViewData["Title"] = "Members List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Members List</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-person-plus"></i> Add Member
    </a>
</div>

<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name or email" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th style="width: 120px;">Photo</th>
            <th>Name</th>
            <th>Email</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var photoPath = !string.IsNullOrEmpty(item.UserPhoto)
            ? Url.Content("~/photos/" + item.UserPhoto)
            : !string.IsNullOrEmpty(item.MemberPhoto)
            ? Url.Content("~/photos/" + item.MemberPhoto)
            : Url.Content("~/photos/default-avatar.png");

            <tr>
                <td>
                    <img src="@photoPath" alt="Photo" class="img-thumbnail" style="width:100px; height:100px; object-fit:cover;" />
                </td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-email="@item.Email" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-email="@item.Email" class="btn btn-sm btn-danger">Delete</a>
                    <button type="button" class="btn btn-sm btn-info"
                            data-bs-toggle="collapse"
                            data-bs-target="#details-@item.Email.Replace("@", "").Replace(".", "")">
                        Details
                    </button>
                </td>
            </tr>
            <tr class="collapse" id="details-@item.Email.Replace("@", "").Replace(".", "")">
                <td colspan="4">
                    <div class="card card-body">
                        <p><strong>Address:</strong> @item.Address</p>
                        <p><strong>Date of Birth:</strong> @(item.DateOfBirth?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Paging -->
<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.CurrentSearch">@i</a>
            </li>
        }
    </ul>
</nav>
