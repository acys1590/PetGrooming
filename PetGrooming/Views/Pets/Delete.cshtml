@model Pet
@{
    ViewData["Title"] = "Delete Pet";
}

<div class="row">
    <div class="col-md-8">
        <h1 class="text-danger"><i class="fas fa-trash"></i> Delete Pet</h1>

        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Are you sure you want to delete this pet?
        </div>

        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name:</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Species:</dt>
                    <dd class="col-sm-9">@Model.Species</dd>

                    <dt class="col-sm-3">Breed:</dt>
                    <dd class="col-sm-9">@Model.Breed</dd>

                    <dt class="col-sm-3">Owner:</dt>
                    <dd class="col-sm-9">@Model.OwnerName</dd>

                    <dt class="col-sm-3">
