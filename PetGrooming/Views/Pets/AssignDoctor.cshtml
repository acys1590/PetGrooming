@model AssignDoctorViewModel
@{
    ViewData["Title"] = "Assign Doctor";
}

<div class="row">
    <div class="col-md-6">
        <h1><i class="fas fa-user-md"></i> Assign Doctor</h1>

        <div class="card">
            <div class="card-header">
                <h5>Pet: @Model.PetName</h5>
            </div>
            <div class="card-body">
                <form asp-action="AssignDoctor">
                    <input type="hidden" asp-for="PetId" />
                    <input type="hidden" asp-for="PetName" />

                    <div class="mb-3">
                        <label asp-for="DoctorId" class="form-label">Select Doctor</label>
                        <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select">
                            <option value="">Choose a doctor...</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-check"></i> Assign Doctor
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

