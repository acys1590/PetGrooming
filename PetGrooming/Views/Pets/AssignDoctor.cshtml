@model AssignDoctorViewModel
@{
    ViewData["Title"] = "Assign Person";
}

<div class="row">
    <div class="col-md-6">
        <h1><i class="fas fa-user-md"></i> Assign Doctor or Staff</h1>

        <div class="card">
            <div class="card-header">
                <h5>Pet: @Model.PetName</h5>
                <h5>Service: @Model.ServiceTypes</h5>
            </div>
            <div class="card-body">
                <form asp-action="AssignDoctor" method="post">
                    <input type="hidden" asp-for="PetId" />
                    <input type="hidden" asp-for="PetName" />

                    <div class="mb-3">
                        <label asp-for="SelectedPerson" class="form-label">Assign To</label>
                        <select asp-for="SelectedPerson" asp-items="Model.People" class="form-select">
                            <option value="">Choose Doctor or Staff...</option>
                        </select>
                        <span asp-validation-for="SelectedPerson" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-check"></i> Assign
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ensure only one is selected at a time
        document.querySelectorAll(".person-select").forEach(select => {
            select.addEventListener("change", function () {
                if (this.value) {
                    document.querySelectorAll(".person-select").forEach(other => {
                        if (other !== this) {
                            other.value = "";
                        }
                    });
                }
            });
        });
    </script>
}
