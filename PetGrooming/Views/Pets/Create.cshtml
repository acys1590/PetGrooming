@model PetViewModel
@{
    ViewData["Title"] = "Add New Pet";
}

<div class="row">
    <div class="col-md-8">
        <h1><i class="fas fa-plus"></i> Add New Pet</h1>

        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <h5><i class="fas fa-dog"></i> Pet Information</h5>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.PetName" class="form-label">Pet Name</label>
                                <input asp-for="Pet.PetName" class="form-control" />
                                <span asp-validation-for="Pet.PetName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.PetType" class="form-label">Pet Tyoe</label>
                                <select asp-for="Pet.PetType" class="form-select">
                                    <option value="">Select Pet Type</option>
                                    <option value="Dog">Dog</option>
                                    <option value="Cat">Cat</option>
                                    <option value="Rabbit">Rabbit</option>
                                    <option value="Guinea Pig">Guinea Pig</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Pet.PetType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.PetBreed" class="form-label">Pet Breed</label>
                                <input asp-for="Pet.PetBreed" class="form-control" />
                                <span asp-validation-for="Pet.PetBreed" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Pet.Age" class="form-label">Age (years)</label>
                                <input asp-for="Pet.Age" class="form-control" type="number" min="0" max="30" />
                                <span asp-validation-for="Pet.Age" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Pet.Gender" class="form-label">Gender</label>
                                <select asp-for="Pet.Gender" class="form-select">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Pet.Gender" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.ServiceType" class="form-label">Service Type</label>
                                <select asp-for="Pet.ServiceType" asp-items="Model.ServiceTypes" class="form-select">
                                    <option value="">-- Select Service --</option>
                                </select>
                                <span asp-validation-for="Pet.ServiceType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.AppointmentDate" class="form-label">Appointment Date & Time</label>
                                <input asp-for="Pet.AppointmentDate" class="form-control" type="datetime-local"
                                       value="@Model.Pet.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="Pet.AppointmentDate" class="text-danger"></span>
                            </div>


                         </div>



                    </div>
               

                    <hr />
                    <h5><i class="fas fa-user"></i> Owner Information</h5>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.OwnerName" class="form-label">Owner Name</label>
                                <input asp-for="Pet.OwnerName" class="form-control" />
                                <span asp-validation-for="Pet.OwnerName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Pet.PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="Pet.PhoneNumber" class="form-control" />
                                <span asp-validation-for="Pet.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Pet.Email" class="form-label">Email Address</label>
                        <input asp-for="Pet.Email" class="form-control" type="email" />
                        <span asp-validation-for="Pet.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Pet.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Pet.Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Pet.Notes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Pet
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>