@using PetGrooming.Models
@model Appointment
@{
    ViewData["Title"] = "Pet Details";
}

<div class="row">
    <div class="col-md-8">
        <h1><i class="fas fa-dog"></i> Pet Details</h1>

        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name:</dt>
                    <dd class="col-sm-9">@Model.PetName</dd>

                    <dt class="col-sm-3">Species:</dt>
                    <dd class="col-sm-9">@Model.PetType</dd>

                    <dt class="col-sm-3">Breed:</dt>
                    <dd class="col-sm-9">@Model.PetBreed</dd>

                    <dt class="col-sm-3">Age:</dt>
                    <dd class="col-sm-9">@Model.Age years</dd>

                    <dt class="col-sm-3">Gender:</dt>
                    <dd class="col-sm-9">@Model.Gender</dd>

                    <!-- Service -->
                    <dt class="col-sm-3">Service:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Service != null)
                        {
                            <span>@Model.Service.Name</span>
                            @if (Model.Service.Price > 0)
                            {
                                <small class="text-muted d-block">Price: @Model.Service.Price.ToString("C")</small>
                            }
                            @if (Model.Service.DurationMinutes > 0)
                            {
                                <small class="text-muted d-block">Duration: @Model.Service.DurationMinutes minutes</small>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.ServiceType))
                        {
                            <span>@Model.ServiceType</span>
                            <small class="badge bg-info ms-1">legacy</small>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Owner:</dt>
                    <dd class="col-sm-9">@Model.OwnerName</dd>

                    <dt class="col-sm-3">Phone:</dt>
                    <dd class="col-sm-9">@Model.PhoneNumber</dd>

                    <dt class="col-sm-3">Assigned Doctor/Staff:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Doctor != null)
                        {
                            <span class="badge bg-success">@Model.Doctor.Name (Doctor)</span>
                        }
                        else if (Model.Staff != null)
                        {
                            <span class="badge bg-primary">@Model.Staff.Name (Staff)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Not Assigned</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Appointment Date:</dt>
                    <dd class="col-sm-9">@Model.AppointmentDate.ToString("MMMM dd, yyyy hh:mm tt")</dd>

                    <dt class="col-sm-3">Notes:</dt>
                    <dd class="col-sm-9">@Model.Notes</dd>
                </dl>

                <div class="mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="AssignDoctor" asp-route-id="@Model.Id" class="btn btn-success">
                        <i class="fas fa-user-md"></i> Assign Doctor
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
