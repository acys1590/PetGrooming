@using PetGrooming.Models
@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Pets Management";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1><i class="fas fa-dog"></i> Pets Management</h1>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Pet
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Species/Breed</th>
                            <th>Age</th>
                            <th>Owner</th>
                            <th>Phone</th>
                            <th>Appointment Date</th>
                            <th>Assigned Doctor</th>
                            <th>Actions</th>
                            <th>Approval</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pet in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@pet.PetName</strong>
                                    <small class="text-muted d-block">@pet.Gender</small>
                                </td>
                                <td>
                                    @pet.PetType
                                    @if (!string.IsNullOrEmpty(pet.PetBreed))
                                    {
                                        <small class="text-muted d-block">@pet.PetBreed</small>
                                    }
                                </td>
                                <td>@pet.Age years</td>
                                <td>@pet.OwnerName</td>
                                <td>@pet.PhoneNumber</td>
                                <td>@pet.AppointmentDate</td>
                                <td>
                                    @if (pet.Doctor != null)
                                    {
                                        <span class="badge bg-success">@pet.Doctor.Name</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Not Assigned</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@pet.Id" class="btn btn-sm btn-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="AssignDoctor" asp-route-id="@pet.Id" class="btn btn-sm btn-success" title="Assign Doctor">
                                            <i class="fas fa-user-md"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-dog fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No pets registered yet</h5>
                <p class="text-muted">Start by adding your first pet to the system.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add First Pet
                </a>
            </div>
        }
    </div>
</div>