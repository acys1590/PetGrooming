@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    Layout = "Main_Layout";
    ViewData["Title"] = "Main Page";
}

<!-- Page-scoped styles (safe & light/dark aware) -->
<style>
    :root {
        --brand: #0d6efd;
        --brand-2: #6610f2;
        --soft: rgba(13,110,253,.08);
        --chip-bg: rgba(13,110,253,.12);
        --glass: rgba(255,255,255,.65);
        --shadow: 0 10px 30px rgba(13,110,253,.15);
        --muted: #6c757d;
    }

    [data-bs-theme="dark"] {
        --soft: rgba(13,110,253,.18);
        --chip-bg: rgba(13,110,253,.2);
        --glass: rgba(32,32,32,.55);
        --shadow: 0 10px 30px rgba(0,0,0,.35);
        --muted: #adb5bd;
    }

    /* HERO */
    .hero-wrap {
        background: radial-gradient(1200px 500px at 10% -10%, var(--soft), transparent 60%), radial-gradient(900px 500px at 110% 10%, var(--soft), transparent 60%), linear-gradient(135deg, rgba(13,110,253,.10), rgba(102,16,242,.08));
        border-radius: 1.25rem;
        box-shadow: var(--shadow);
    }

    .hero-card {
        backdrop-filter: blur(8px);
        background: var(--glass);
        border: 1px solid rgba(255,255,255,.35);
    }

    .emoji-xl {
        font-size: 5.5rem;
        line-height: 1;
    }

    .btn-cta {
        padding: .9rem 1.25rem;
        border-radius: .85rem;
        box-shadow: 0 8px 18px rgba(13,110,253,.25);
    }

    .btn-ghost {
        border: 1px solid rgba(13,110,253,.35);
        background: transparent;
    }

    /* SERVICES */
    .svc-card {
        border: 0;
        border-radius: 1rem;
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .svc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(13,110,253,.18);
        }

    .svc-icon {
        width: 64px;
        height: 64px;
        border-radius: 1rem;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #fff;
        font-size: 1.8rem;
        margin: 0 auto 1rem auto;
        box-shadow: 0 10px 22px rgba(13,110,253,.35);
    }

    .price-tag {
        color: var(--brand);
        font-weight: 700;
    }

    /* WHY CHOOSE */
    .why-chip {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .6rem .9rem;
        border-radius: .75rem;
        background: var(--chip-bg);
        color: var(--brand);
        font-weight: 600;
    }

    .why-list .item {
        padding: .4rem 0;
        display: flex;
        gap: .75rem;
        align-items: flex-start;
    }

    .why-bullet {
        width: 32px;
        height: 32px;
        border-radius: .55rem;
        display: grid;
        place-items: center;
        background: var(--chip-bg);
        color: var(--brand);
        flex: 0 0 32px;
    }

    /* CTA */
    .cta-wrap {
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(13,110,253,.10), rgba(102,16,242,.10));
        padding: 2.2rem 1.5rem;
    }
</style>

<!-- HERO -->
<section class="container my-4 my-md-5">
    <div class="hero-wrap p-3 p-md-4">
        <div class="hero-card rounded-4 p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <h1 class="display-5 fw-bold text-primary mb-3">
                        Welcome to Pawsome Pet Grooming
                    </h1>
                    <p class="lead mb-4 text-secondary">
                        Professional pet grooming services for your beloved companions.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary btn-cta">
                            ✂️ Book Appointment
                        </a>
                        <a asp-controller="Appointment" asp-action="Index" class="btn btn-ghost btn-cta text-primary">
                            📅 View Appointments
                        </a>
                    </div>
                </div>
                <div class="col-lg-5 text-center">
                    <div class="emoji-xl">🐶✨🐱</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SERVICES -->
<section id="services" class="container my-5">
    <h2 class="text-center fw-bold mb-4">Our Services</h2>
    <p class="text-center text-secondary mb-5">Gentle care, clean results, and happier pets.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card svc-card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="svc-icon">✂️</div>
                    <h5 class="fw-bold">Full Grooming</h5>
                    <p class="text-secondary mb-3">
                        Bath, haircut, nail trim, ear cleaning — the full spa package.
                    </p>
                    <div class="price-tag">Starting at RM80</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card svc-card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="svc-icon">🛁</div>
                    <h5 class="fw-bold">Bath & Basic Care</h5>
                    <p class="text-secondary mb-3">
                        Premium shampoo bath, light brushing, and tidy nails.
                    </p>
                    <div class="price-tag">Starting at RM40</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card svc-card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="svc-icon">🦷</div>
                    <h5 class="fw-bold">Nail & Dental Care</h5>
                    <p class="text-secondary mb-3">
                        Nail trimming and basic dental freshening for confident smiles.
                    </p>
                    <div class="price-tag">Starting at RM30</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WHY CHOOSE -->
<section class="container my-5">
    <div class="text-center mb-4">
        <span class="why-chip"><span>🐾</span> Why Choose Us</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h2 class="fw-bold text-center mb-4">Why Choose Pawsome Pet Grooming?</h2>

                    <div class="row why-list g-3">
                        <div class="col-md-6">
                            <div class="item">
                                <span class="why-bullet">✅</span>
                                <div>
                                    <div class="fw-semibold">Experienced & certified groomers</div>
                                    <small class="text-secondary">Handled by trained professionals.</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="item">
                                <span class="why-bullet">🛡️</span>
                                <div>
                                    <div class="fw-semibold">Safe, comfortable environment</div>
                                    <small class="text-secondary">Clean facilities & gentle handling.</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="item">
                                <span class="why-bullet">🧴</span>
                                <div>
                                    <div class="fw-semibold">High-quality products</div>
                                    <small class="text-secondary">Pet-friendly shampoos & tools.</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="item">
                                <span class="why-bullet">❤️</span>
                                <div>
                                    <div class="fw-semibold">Personalized care</div>
                                    <small class="text-secondary">Tailored to your pet’s needs.</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="item">
                                <span class="why-bullet">🏷️</span>
                                <div>
                                    <div class="fw-semibold">Competitive pricing</div>
                                    <small class="text-secondary">Clear, fair rates — no surprises.</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="item">
                                <span class="why-bullet">⏰</span>
                                <div>
                                    <div class="fw-semibold">Flexible scheduling</div>
                                    <small class="text-secondary">Convenient time slots.</small>
                                </div>
                            </div>
                        </div>
                    </div> <!-- /row -->
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="container my-5">
    <div class="cta-wrap text-center">
        <h3 class="fw-bold mb-2">Ready to pamper your pet?</h3>
        <p class="text-secondary mb-4">Book an appointment and give your furry friend the royal treatment.</p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Appointment" asp-action="Create" class="btn btn-success btn-cta">
                ✂️ Book Now
            </a>
        </div>
    </div>
</section>
