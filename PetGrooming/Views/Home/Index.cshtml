@using PetGrooming.Models
@using PetGroomingSystem.Models
@model IEnumerable<Appointment>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1><i class="fas fa-tachometer-alt"></i> Pet Grooming Dashboard</h1>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@ViewBag.TotalPets</h4>
                        <p class="card-text">Total Pets</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-dog fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@ViewBag.TotalEmployees</h4>
                        <p class="card-text">Active Doctors/Staff</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-user-md fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
 <div class="col-md-3">
    <div class="card text-white bg-warning">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <div>
                    <h4 class="card-title">@ViewBag.PetsWithEmployees</h4>
                    <p class="card-text">Assigned Pets</p>
                </div>
                <div class="align-self-center">
                    <i class="fas fa-check fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-3">
    <div class="card text-white bg-danger">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <div>
                    <h4 class="card-title">@ViewBag.PetsWithoutEmployees</h4>
                    <p class="card-text">Unassigned Pets</p>
                </div>
                <div class="align-self-center">
                    <i class="fas fa-times fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
 </div>
</div>


<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-chart-pie"></i> Pets Handled by Doctor/Staff</h5>
            </div>
            <div class="card-body text-center">
                <canvas id="petsPieChart" style="max-width:500px; max-height:500px; margin:auto;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('petsPieChart').getContext('2d');
        var petsPieChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.Handlers)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.Counts)),
                    backgroundColor: [
                        '#007bff', '#28a745', '#ffc107', '#dc3545',
                        '#6f42c1', '#20c997', '#fd7e14'
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 20, padding: 15 }
                    }
                }
            }
        });
    </script>
}





