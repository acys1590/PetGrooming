@model IEnumerable<Pet>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h1><i class="fas fa-tachometer-alt"></i> Pet Grooming Dashboard</h1>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@ViewBag.TotalPets</h4>
                        <p class="card-text">Total Pets</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-dog fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@ViewBag.TotalDoctors</h4>
                        <p class="card-text">Active Doctors</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-user-md fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@ViewBag.PetsWithDoctors</h4>
                        <p class="card-text">Assigned Pets</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@ViewBag.PetsWithoutDoctors</h4>
                        <p class="card-text">Unassigned Pets</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-times fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-clock"></i> Recent Pets</h5>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Pet Name</th>
                                    <th>Species</th>
                                    <th>Owner</th>
                                    <th>Assigned Doctor</th>
                                    <th>Created Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pet in Model)
                                {
                                    <tr>
                                        <td>@pet.Name</td>
                                        <td>@pet.Species</td>
                                        <td>@pet.OwnerName</td>
                                        <td>
                                            @if (pet.Doctor != null)
                                            {
                                                <span class="badge bg-success">@pet.Doctor.Name</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Not Assigned</span>
                                            }
                                        </td>
                                        <td>@pet.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No pets registered yet.</p>
                }
                <div class="mt-3">
                    <a asp-controller="Pets" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-list"></i> View All Pets
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
