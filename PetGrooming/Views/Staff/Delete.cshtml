@using PetGrooming.Models
@model Staff
@{
    ViewData["Title"] = "Delete Staff";
}

<div class="row">
    <div class="col-md-8">
        <h1 class="text-danger"><i class="fas fa-trash"></i> Delete Staff</h1>

        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Are you sure you want to delete this doctor?
        </div>

        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name:</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Phone:</dt>
                    <dd class="col-sm-9">@Model.Phone</dd>

                    <dt class="col-sm-3">Email:</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3">Join Date:</dt>
                    <dd class="col-sm-9">@Model.JoinDate.ToString("MMMM dd, yyyy")</dd>

                    <dt class="col-sm-3">Assigned Pets:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info">@Model.Pets.Count() pets</span>
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>