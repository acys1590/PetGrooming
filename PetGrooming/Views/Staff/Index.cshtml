@using PetGrooming.Models
@model IEnumerable<Staff>
@{
    ViewData["Title"] = "Staffs Management";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h1><i class="fas fa-user-md"></i> Staffs Management</h1>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Staff
        </a>
    </div>
</div>


<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Assigned Pets</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in Model)
                        {
                            <tr class="@(staff.IsActive ? "" : "table-secondary")">
                                <td>
                                    <strong>@staff.Name</strong>
                                    <small class="text-muted d-block">Joined: @staff.JoinDate.ToString("MMM yyyy")</small>
                                </td>
                               
                                <td>
                                    @staff.Phone
                                    @if (!string.IsNullOrEmpty(staff.Email))
                                    {
                                        <small class="text-muted d-block">@staff.Email</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@staff.Pets.Count() pets</span>
                                </td>
                                <td>
                                    @if (staff.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@staff.Id" class="btn btn-sm btn-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@staff.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="ToggleStatus" asp-route-id="@staff.Id" class="btn btn-sm @(staff.IsActive ? "btn-secondary" : "btn-success")" title="@(staff.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(staff.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </a>
                                        @if (staff.Pets.Count() == 0)
                                        {
                                            <a asp-action="Delete" asp-route-id="@staff.Id" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-user-md fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No staffs registered yet</h5>
                <p class="text-muted">Start by adding your first staff to the system.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add First Staff
                </a>
            </div>
        }
    </div>
</div>